# NeuralNote 2.2.0 COPR prototype: standalone app + VST3.
# Source0 MUST be the fully vendored, reproducible archive generated by
# scripts/prepare-sources.sh (not GitHub's default release archive).
# Build the source archive before entering the network-isolated RPM chroot.
# Licensing (especially JUCE/AGPL) needs owner review before public distribution.

%global toolchain clang

%bcond_without vulkan

%if %{with vulkan}
%global nn_vulkan ON
%else
%global nn_vulkan OFF
%endif

Name:           neuralnote
Version:        2.2.0
Release:        1%{?dist}
Summary:        Local audio-to-MIDI transcription (standalone and VST3)
License:        Apache-2.0 AND AGPL-3.0-or-later AND MIT AND BSD-3-Clause AND OFL-1.1 AND CC0-1.0
URL:            https://github.com/DamRsn/NeuralNote
Source0:        neuralnote-%{version}-vendored.tar.xz

ExclusiveArch:  x86_64

BuildRequires:  clang
BuildRequires:  cmake >= 3.24
BuildRequires:  ninja-build
BuildRequires:  python3
BuildRequires:  pkgconf-pkg-config
BuildRequires:  desktop-file-utils
BuildRequires:  alsa-lib-devel
BuildRequires:  jack-audio-connection-kit-devel
BuildRequires:  ladspa-devel
BuildRequires:  libcurl-devel
BuildRequires:  freetype-devel
BuildRequires:  fontconfig-devel
BuildRequires:  libX11-devel
BuildRequires:  libXcomposite-devel
BuildRequires:  libXcursor-devel
BuildRequires:  libXext-devel
BuildRequires:  libXinerama-devel
BuildRequires:  libXrandr-devel
BuildRequires:  libXrender-devel
BuildRequires:  mesa-libGLU-devel
BuildRequires:  mesa-libGL-devel
BuildRequires:  libglvnd-devel
BuildRequires:  webkit2gtk4.1-devel
%if %{with vulkan}
BuildRequires:  vulkan-loader-devel
BuildRequires:  vulkan-headers
BuildRequires:  glslc
BuildRequires:  spirv-headers-devel
%endif

Requires:       hicolor-icon-theme

%description
NeuralNote transcribes audio into MIDI locally using the MuScriptor inference
engine. This package includes a standalone desktop application and a VST3
plugin. Transcription model weights are not bundled: NeuralNote downloads them
only when requested by the user. Those weights are licensed separately and
are restricted to non-commercial use by their authors.

%prep
%autosetup -n NeuralNote-%{version}
# Never allow a hidden network fallback in the RPM build chroot.
test -d ThirdParty/JUCE/modules
test -f ThirdParty/muscriptor.cpp/cpp/CMakeLists.txt
test -f ThirdParty/ggml-pinned/CMakeLists.txt
test -s NeuralNote/Assets/SoundFont/NeuralNote_GM.sf3

%build
export CC=/usr/bin/clang
export CXX=/usr/bin/clang++
cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DCMAKE_INSTALL_PREFIX=%{_prefix} \
    -DNEURALNOTE_FETCH_SOUNDFONT=OFF \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DFETCHCONTENT_SOURCE_DIR_GGML="$PWD/ThirdParty/ggml-pinned" \
    -DMUSCRIPTOR_VULKAN=%{nn_vulkan} \
    -DMUSCRIPTOR_NATIVE=OFF \
    -DMUSCRIPTOR_CPU_VARIANTS=OFF \
    -DNEURALNOTE_SYMBOLS=ON \
    -DLTO=OFF
# Limit parallelism; ggml + JUCE + Vulkan shader generation can exhaust COPR RAM.
cmake --build build --target NeuralNote_Standalone NeuralNote_VST3 --parallel 3

%install
install -Dm0755 build/NeuralNote_artefacts/Release/Standalone/NeuralNote \
    %{buildroot}%{_bindir}/neuralnote
install -d %{buildroot}%{_libdir}/vst3
cp -a build/NeuralNote_artefacts/Release/VST3/NeuralNote.vst3 \
    %{buildroot}%{_libdir}/vst3/
install -Dm0644 packaging/neuralnote.desktop \
    %{buildroot}%{_datadir}/applications/neuralnote.desktop
install -Dm0644 NeuralNote/Assets/Logo/neuralnote-1024.png \
    %{buildroot}%{_datadir}/pixmaps/neuralnote.png

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/neuralnote.desktop
test -x %{buildroot}%{_bindir}/neuralnote
test -n "$(find %{buildroot}%{_libdir}/vst3/NeuralNote.vst3 -type f -name '*.so' -print -quit)"

%files
%license LICENSE Installers/license.txt
%doc README.md
%{_bindir}/neuralnote
%{_datadir}/applications/neuralnote.desktop
%{_datadir}/pixmaps/neuralnote.png
%{_libdir}/vst3/NeuralNote.vst3/

%changelog
